    var spiderTop = e.clientY - rect.top - wall.clientTop - spider.offsetHeight / 2;
    var maxLeft = wall.clientWidth - spider.offsetWidth;
    var maxTop = wall.clientHeight - spider.offsetHeight;
    if (spiderLeft < 0) spiderLeft = 0;
